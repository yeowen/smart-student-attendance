{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/conf/php/(.*)$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/checkin/(.*)$",
      "dest": "/api/index.php?token=$1"
    },
    {
      "src": "^/checkin$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/student_checkin.php$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/css/(.*)$",
      "dest": "/pub/css/$1"
    },
    {
      "src": "^/js/(.*)$",
      "dest": "/pub/js/$1"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/pub/assets/$1"
    },
    {
      "src": "^/pub/css/(.*)$",
      "dest": "/pub/css/$1"
    },
    {
      "src": "^/pub/js/(.*)$",
      "dest": "/pub/js/$1"
    },
    {
      "src": "^/pub/assets/(.*)$",
      "dest": "/pub/assets/$1"
    },
    {
      "src": "^/uploads/(.*)$",
      "dest": "/uploads/$1"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/dashboard(\\.html)?$",
      "dest": "/pub/html/dashboard.html"
    },
    {
      "src": "^/sections(\\.html)?$",
      "dest": "/pub/html/sections.html"
    },
    {
      "src": "^/section_details(\\.html)?$",
      "dest": "/pub/html/section_details.html"
    },
    {
      "src": "^/attendance_sessions(\\.html)?$",
      "dest": "/pub/html/attendance_sessions.html"
    },
    {
      "src": "^/reports(\\.html)?$",
      "dest": "/pub/html/reports.html"
    },
    {
      "src": "^/settings(\\.html)?$",
      "dest": "/pub/html/settings.html"
    },
    {
      "src": "^/student_form_editor(\\.html)?$",
      "dest": "/pub/html/student_form_editor.html"
    },
    {
      "src": "^/login(\\.html)?$",
      "dest": "/pub/html/login.html"
    },
    {
      "src": "^/pub/html/([^/]+)(\\.html)?$",
      "dest": "/pub/html/$1.html"
    },
    {
      "src": "^/([^/]+)\\.html$",
      "dest": "/pub/html/$1.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
