{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/conf/php/(.*)$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/checkin/(.*)$",
      "dest": "/api/index.php?token=$1"
    },
    {
      "src": "^/checkin$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/student_checkin.php$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/login$",
      "dest": "/pub/html/login.html"
    },
    {
      "src": "^/pub/html/login$",
      "dest": "/pub/html/login.html"
    },
    {
      "src": "^/dashboard$",
      "dest": "/pub/html/dashboard.html"
    },
    {
      "src": "^/pub/html/dashboard$",
      "dest": "/pub/html/dashboard.html"
    },
    {
      "src": "^/sections$",
      "dest": "/pub/html/sections.html"
    },
    {
      "src": "^/pub/html/sections$",
      "dest": "/pub/html/sections.html"
    },
    {
      "src": "^/attendance_sessions$",
      "dest": "/pub/html/attendance_sessions.html"
    },
    {
      "src": "^/pub/html/attendance_sessions$",
      "dest": "/pub/html/attendance_sessions.html"
    },
    {
      "src": "^/reports$",
      "dest": "/pub/html/reports.html"
    },
    {
      "src": "^/pub/html/reports$",
      "dest": "/pub/html/reports.html"
    },
    {
      "src": "^/settings$",
      "dest": "/pub/html/settings.html"
    },
    {
      "src": "^/pub/html/settings$",
      "dest": "/pub/html/settings.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
